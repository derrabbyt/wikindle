# Copy to .env next to docker-compose.yml. Never commit the real thing.

# --- database ---------------------------------------------------------------
# This goes straight into a connection URI, so it must contain no spaces and no
# URI-significant characters. Generate one with:  openssl rand -hex 24
# (hex deliberately, not base64: + / = would need percent-encoding.)
POSTGRES_PASSWORD=change-me

# --- mail -------------------------------------------------------------------
# Typed into Amazon Approved Sender Lists by hand, so it is kept as short as
# possible and can never change without silently cutting off every existing
# subscriber.
WIKINDLE_RESEND_API_KEY=
WIKINDLE_SENDER_ADDRESS=read@wikindle.xyz
WIKINDLE_SENDER_NAME=wikindle

# --- public surface ---------------------------------------------------------
# The hostname the Cloudflare Tunnel exposes. Used in confirmation links.
WIKINDLE_PUBLIC_URL=https://api.wikindle.xyz
CLOUDFLARE_TUNNEL_TOKEN=

# --- behaviour --------------------------------------------------------------
# Which Wikipedia the shared daily Edition is drawn from. Pasted links may be
# any language regardless of this.
WIKINDLE_LANGUAGE=en

# Bump to invalidate the Conversion cache after fixing the converter.
WIKINDLE_CONVERTER_VERSION=1

# Image tag to run; CI publishes :latest and :<sha>.
WIKINDLE_TAG=latest
